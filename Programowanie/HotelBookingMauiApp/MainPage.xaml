<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelBookingMauiApp.MainPage"
             x:Name="thisPage"
             BindingContext="{x:Reference thisPage}">

    <ScrollView>
        <StackLayout Spacing="12" >
            <StackLayout Orientation="Horizontal" Spacing="12" >
                <Label Text="Imię i nazwisko" VerticalOptions="Center"/>
                <Entry Text="{Binding FullName}"
                       Placeholder="wpisz imie i nazwisko"/>
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="12">
                <Label Text="Adres e-mail" VerticalOptions="Center"/>
                <Entry Text="{Binding Email}"
                       Keyboard="Email"
                       Placeholder="wpisz adres e-mail"/>
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="12">
                <Label Text="Data przyjazdu" VerticalOptions="Center"/>
                <DatePicker Date="{Binding ArrivalDate}"
                            MinimumDate="{Binding MinimumDate}"/>
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="12">
                <Label Text="Liczba nocy" 
                       VerticalOptions="Center"/>
                <Stepper 
                    Increment="1"
                    Minimum="1"
                    Maximum="14"
                    Value="{Binding Nights}"/>

                <Label Text="{Binding Nights}"
                       VerticalOptions="Center"/>
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="12">
                <Label Text="Liczba osób" VerticalOptions="Center"/>
                <Stepper 
                    Increment="1"
                    Minimum="1"
                    Maximum="4"
                    Value="{Binding Persons}"/>

                <Label Text="{Binding Persons}"
                       VerticalOptions="Center"/>

            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="12">

                <Label Text="Rodzaj pokoju:" VerticalOptions="Center"/>
                <Picker
                    ItemsSource="{Binding RoomCollection}"
                    SelectedItem="{Binding SelectedRoom}"
                    />
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="12">
                <Label Text="Śnadanie:" VerticalOptions="Center"/>
                <Switch IsToggled="{Binding Breakfast}"/>
                <Label Text="{Binding Breakfast}"  VerticalOptions="Center"/>
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="12">
                <Label Text="Miejsce parkingowe:" VerticalOptions="Center"/>
                <CheckBox IsChecked="{Binding Parking}"/>
                <Label Text="{Binding Parking}"  VerticalOptions="Center"/>
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="12">
                <Label Text="Rabat" VerticalOptions="Center"/>
                <Slider
                    Minimum="0"
                    Maximum="20"
                    Value="{Binding Discount}"
                    WidthRequest="200"
                    />
                <Label Text="{Binding Discount}"
                       VerticalOptions="Center"/>
                <Label Text="%"
                       VerticalOptions="Center"/>
            </StackLayout>

            <Button Command="{Binding CalculateReservation}"
                    Text="Oblicz koszt"
                    />

            <Label Text="Podsumowanie:"/>
            <Label Text="{Binding Summary}"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
